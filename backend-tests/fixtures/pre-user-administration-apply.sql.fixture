-- PostgreSQL database contract for GDS SEDENA.
-- This is the only SQL artifact required to install, reapply, or verify
-- the database. It is self-contained: copy this file to the server and
-- execute it with any PostgreSQL SQL client. Every DDL statement is guarded, seeds use
-- ON CONFLICT, and the final checks expose structural or import drift.

BEGIN;

-- =====================================================================
-- 1. Identity
-- =====================================================================
CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- ASP.NET Core Identity-compatible tables. UUID keys match
-- IdentityRole<Guid>/ApplicationUser. This reviewed SQL is the schema source
-- of truth; the application must adapt to it without generating migrations.
CREATE TABLE IF NOT EXISTS public."AspNetUsers" (
    "Id" uuid PRIMARY KEY,
    "UserName" varchar(256),
    "NormalizedUserName" varchar(256),
    "Email" varchar(256),
    "NormalizedEmail" varchar(256),
    "EmailConfirmed" boolean NOT NULL DEFAULT false,
    "PasswordHash" text,
    "SecurityStamp" text,
    "ConcurrencyStamp" text,
    "PhoneNumber" text,
    "PhoneNumberConfirmed" boolean NOT NULL DEFAULT false,
    "TwoFactorEnabled" boolean NOT NULL DEFAULT false,
    "LockoutEnd" timestamptz,
    "LockoutEnabled" boolean NOT NULL DEFAULT true,
    "AccessFailedCount" integer NOT NULL DEFAULT 0 CHECK ("AccessFailedCount" >= 0),
    "DisplayName" varchar(200) NOT NULL DEFAULT '',
    "IsActive" boolean NOT NULL DEFAULT true,
    "CreatedAt" timestamptz NOT NULL DEFAULT now(),
    "UpdatedAt" timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS public."AspNetRoles" (
    "Id" uuid PRIMARY KEY,
    "Name" varchar(256),
    "NormalizedName" varchar(256),
    "ConcurrencyStamp" text
);

CREATE TABLE IF NOT EXISTS public."AspNetUserClaims" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "UserId" uuid NOT NULL REFERENCES public."AspNetUsers"("Id") ON DELETE CASCADE,
    "ClaimType" text,
    "ClaimValue" text
);

CREATE TABLE IF NOT EXISTS public."AspNetUserLogins" (
    "LoginProvider" varchar(128) NOT NULL,
    "ProviderKey" varchar(128) NOT NULL,
    "ProviderDisplayName" text,
    "UserId" uuid NOT NULL REFERENCES public."AspNetUsers"("Id") ON DELETE CASCADE,
    PRIMARY KEY ("LoginProvider", "ProviderKey")
);

CREATE TABLE IF NOT EXISTS public."AspNetUserRoles" (
    "UserId" uuid NOT NULL REFERENCES public."AspNetUsers"("Id") ON DELETE CASCADE,
    "RoleId" uuid NOT NULL REFERENCES public."AspNetRoles"("Id") ON DELETE CASCADE,
    PRIMARY KEY ("UserId", "RoleId")
);

CREATE TABLE IF NOT EXISTS public."AspNetUserTokens" (
    "UserId" uuid NOT NULL REFERENCES public."AspNetUsers"("Id") ON DELETE CASCADE,
    "LoginProvider" varchar(128) NOT NULL,
    "Name" varchar(128) NOT NULL,
    "Value" text,
    PRIMARY KEY ("UserId", "LoginProvider", "Name")
);

CREATE TABLE IF NOT EXISTS public."AspNetRoleClaims" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "RoleId" uuid NOT NULL REFERENCES public."AspNetRoles"("Id") ON DELETE CASCADE,
    "ClaimType" text,
    "ClaimValue" text
);

CREATE UNIQUE INDEX IF NOT EXISTS "UserNameIndex"
    ON public."AspNetUsers" ("NormalizedUserName")
    WHERE "NormalizedUserName" IS NOT NULL;
CREATE INDEX IF NOT EXISTS "EmailIndex" ON public."AspNetUsers" ("NormalizedEmail");
CREATE UNIQUE INDEX IF NOT EXISTS "RoleNameIndex"
    ON public."AspNetRoles" ("NormalizedName")
    WHERE "NormalizedName" IS NOT NULL;
CREATE INDEX IF NOT EXISTS "IX_AspNetUserClaims_UserId" ON public."AspNetUserClaims" ("UserId");
CREATE INDEX IF NOT EXISTS "IX_AspNetUserLogins_UserId" ON public."AspNetUserLogins" ("UserId");
CREATE INDEX IF NOT EXISTS "IX_AspNetUserRoles_RoleId" ON public."AspNetUserRoles" ("RoleId");
CREATE INDEX IF NOT EXISTS "IX_AspNetRoleClaims_RoleId" ON public."AspNetRoleClaims" ("RoleId");

-- =====================================================================
-- 2. Catalogs
-- =====================================================================
CREATE SCHEMA IF NOT EXISTS app;

CREATE TABLE IF NOT EXISTS app.catalog_options (
    catalog_key text NOT NULL,
    id uuid NOT NULL,
    code text NOT NULL,
    label text NOT NULL,
    sort_order integer NOT NULL CHECK (sort_order >= 0),
    is_active boolean NOT NULL DEFAULT true,
    version bigint NOT NULL DEFAULT 1 CHECK (version > 0),
    stage_codes text[] NOT NULL DEFAULT '{}',
    metadata jsonb NOT NULL DEFAULT '{}',
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    PRIMARY KEY (catalog_key, id),
    UNIQUE (catalog_key, code),
    CHECK (code = btrim(code) AND code <> ''),
    CHECK (label = btrim(label) AND label <> ''),
    CHECK (stage_codes <@ ARRAY['indications','reconnaissance','surveillance','mitigation']::text[])
) PARTITION BY LIST (catalog_key);

CREATE TABLE IF NOT EXISTS app.cat_mexico_states PARTITION OF app.catalog_options FOR VALUES IN ('mexicoStates');
CREATE TABLE IF NOT EXISTS app.cat_soils PARTITION OF app.catalog_options FOR VALUES IN ('soils');
CREATE TABLE IF NOT EXISTS app.cat_seasons PARTITION OF app.catalog_options FOR VALUES IN ('seasons');
CREATE TABLE IF NOT EXISTS app.cat_risk_levels PARTITION OF app.catalog_options FOR VALUES IN ('riskLevels');
CREATE TABLE IF NOT EXISTS app.cat_sensors PARTITION OF app.catalog_options FOR VALUES IN ('sensors');
CREATE TABLE IF NOT EXISTS app.cat_platforms PARTITION OF app.catalog_options FOR VALUES IN ('platforms');
CREATE TABLE IF NOT EXISTS app.cat_indication_sources PARTITION OF app.catalog_options FOR VALUES IN ('indicationSources');
CREATE TABLE IF NOT EXISTS app.cat_indication_signatures PARTITION OF app.catalog_options FOR VALUES IN ('indicationSignatures');
CREATE TABLE IF NOT EXISTS app.cat_radio_technologies PARTITION OF app.catalog_options FOR VALUES IN ('radioTechnologies');
CREATE TABLE IF NOT EXISTS app.cat_surveillance_methods PARTITION OF app.catalog_options FOR VALUES IN ('surveillanceMethods');
CREATE TABLE IF NOT EXISTS app.cat_surveillance_deployments PARTITION OF app.catalog_options FOR VALUES IN ('surveillanceDeployments');
CREATE TABLE IF NOT EXISTS app.cat_human_activities PARTITION OF app.catalog_options FOR VALUES IN ('humanActivities');
CREATE TABLE IF NOT EXISTS app.cat_environment_decisions PARTITION OF app.catalog_options FOR VALUES IN ('environmentDecisions');
CREATE TABLE IF NOT EXISTS app.cat_protection_levels PARTITION OF app.catalog_options FOR VALUES IN ('protectionLevels');
CREATE TABLE IF NOT EXISTS app.cat_neutralization_results PARTITION OF app.catalog_options FOR VALUES IN ('neutralizationResults');
CREATE TABLE IF NOT EXISTS app.cat_route_results PARTITION OF app.catalog_options FOR VALUES IN ('routeResults');
CREATE TABLE IF NOT EXISTS app.cat_findings PARTITION OF app.catalog_options FOR VALUES IN ('findings');
CREATE TABLE IF NOT EXISTS app.cat_environment_reviews PARTITION OF app.catalog_options FOR VALUES IN ('environmentReviews');
CREATE TABLE IF NOT EXISTS app.cat_workflow_statuses PARTITION OF app.catalog_options FOR VALUES IN ('workflowStatuses');
CREATE TABLE IF NOT EXISTS app.workflow_stages PARTITION OF app.catalog_options FOR VALUES IN ('workflowStages');

CREATE INDEX IF NOT EXISTS ix_catalog_options_active_order
    ON app.catalog_options (catalog_key, is_active, sort_order, code);
CREATE INDEX IF NOT EXISTS ix_catalog_options_stage_codes
    ON app.catalog_options USING gin (stage_codes);

CREATE OR REPLACE FUNCTION app.touch_catalog_option()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    NEW.updated_at := now();
    NEW.version := OLD.version + 1;
    RETURN NEW;
END $$;

DROP TRIGGER IF EXISTS trg_catalog_options_touch ON app.catalog_options;
CREATE TRIGGER trg_catalog_options_touch
BEFORE UPDATE ON app.catalog_options
FOR EACH ROW EXECUTE FUNCTION app.touch_catalog_option();

-- =====================================================================
-- 3. Incidents and phases
-- =====================================================================
CREATE TABLE IF NOT EXISTS app.incidents (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    public_id text NOT NULL UNIQUE,
    owner_user_id uuid REFERENCES public."AspNetUsers"("Id") ON DELETE RESTRICT,
    legacy_user_id text,
    title varchar(120) NOT NULL,
    content varchar(10000) NOT NULL DEFAULT '',
    area_of_interest varchar(100),
    latitude double precision,
    longitude double precision,
    status_catalog_key text NOT NULL DEFAULT 'workflowStatuses' CHECK (status_catalog_key = 'workflowStatuses'),
    status_code text NOT NULL DEFAULT 'open',
    revision integer NOT NULL DEFAULT 0 CHECK (revision >= 0),
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    deleted_at timestamptz,
    deleted_by_user_id uuid REFERENCES public."AspNetUsers"("Id") ON DELETE RESTRICT,
    CONSTRAINT fk_incident_status FOREIGN KEY (status_catalog_key, status_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_incident_public_id CHECK (public_id = btrim(public_id) AND public_id <> ''),
    CONSTRAINT ck_incident_coordinates CHECK (
        (latitude IS NULL AND longitude IS NULL)
        OR (latitude BETWEEN -90 AND 90 AND longitude BETWEEN -180 AND 180)
    ),
    CONSTRAINT ck_incident_deletion CHECK (
        (deleted_at IS NULL AND deleted_by_user_id IS NULL)
        OR deleted_at IS NOT NULL
    )
);

CREATE INDEX IF NOT EXISTS ix_incidents_owner_updated
    ON app.incidents(owner_user_id, updated_at DESC, id) WHERE deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS ix_incidents_status_updated
    ON app.incidents(status_code, updated_at DESC, id) WHERE deleted_at IS NULL;

CREATE TABLE IF NOT EXISTS app.incident_phases (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    incident_id uuid NOT NULL REFERENCES app.incidents(id) ON DELETE CASCADE,
    stage_catalog_key text NOT NULL DEFAULT 'workflowStages' CHECK (stage_catalog_key = 'workflowStages'),
    stage_code text NOT NULL,
    soil_catalog_key text NOT NULL DEFAULT 'soils' CHECK (soil_catalog_key = 'soils'),
    soil_code text NOT NULL DEFAULT 'unknown',
    season_catalog_key text NOT NULL DEFAULT 'seasons' CHECK (season_catalog_key = 'seasons'),
    season_code text NOT NULL DEFAULT 'unknown',
    terrain_notes text NOT NULL DEFAULT '',
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT uq_incident_phase UNIQUE (incident_id, stage_code),
    CONSTRAINT uq_phase_id_stage UNIQUE (id, stage_code),
    CONSTRAINT fk_phase_stage FOREIGN KEY (stage_catalog_key, stage_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_phase_soil FOREIGN KEY (soil_catalog_key, soil_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_phase_season FOREIGN KEY (season_catalog_key, season_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT
);

CREATE TABLE IF NOT EXISTS app.phase_reviews (
    phase_id uuid PRIMARY KEY REFERENCES app.incident_phases(id) ON DELETE CASCADE,
    finding_catalog_key text NOT NULL DEFAULT 'findings' CHECK (finding_catalog_key = 'findings'),
    finding_code text NOT NULL DEFAULT 'pending',
    environment_catalog_key text NOT NULL DEFAULT 'environmentReviews' CHECK (environment_catalog_key = 'environmentReviews'),
    environment_code text NOT NULL DEFAULT 'pending',
    baseline text NOT NULL DEFAULT '',
    comparison text NOT NULL DEFAULT '',
    report text NOT NULL DEFAULT '',
    techint text NOT NULL DEFAULT '',
    reviewer_display_name varchar(200) NOT NULL DEFAULT '',
    notes text NOT NULL DEFAULT '',
    CONSTRAINT fk_review_finding FOREIGN KEY (finding_catalog_key, finding_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_review_environment FOREIGN KEY (environment_catalog_key, environment_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT
);

CREATE TABLE IF NOT EXISTS app.phase_indications (
    phase_id uuid PRIMARY KEY,
    stage_code text NOT NULL DEFAULT 'indications' CHECK (stage_code = 'indications'),
    platform_catalog_key text NOT NULL DEFAULT 'platforms' CHECK (platform_catalog_key = 'platforms'),
    platform_code text,
    blue_uas_ndaa_compliant boolean NOT NULL DEFAULT false,
    flight_duration_min numeric(10,3),
    lidar_point_rate numeric(18,3),
    payload_lb numeric(10,3),
    mission_speed_mph numeric(10,3),
    wind_knots numeric(10,3),
    terrain_model_reference text NOT NULL DEFAULT '',
    differential_analysis_completed boolean NOT NULL DEFAULT false,
    surface_variation_mm numeric(12,3),
    actionable_alert_generated boolean NOT NULL DEFAULT false,
    personnel_not_exposed boolean NOT NULL DEFAULT false,
    coordinate_transferred_to_veles boolean NOT NULL DEFAULT false,
    observed_at timestamptz,
    observed_at_original text,
    collection_source_catalog_key text NOT NULL DEFAULT 'indicationSources' CHECK (collection_source_catalog_key = 'indicationSources'),
    collection_source_code text,
    alternative_causes text NOT NULL DEFAULT '',
    depression_depth_cm numeric(10,3),
    CONSTRAINT fk_indication_phase FOREIGN KEY (phase_id, stage_code)
        REFERENCES app.incident_phases(id, stage_code) ON DELETE CASCADE,
    CONSTRAINT fk_indication_platform FOREIGN KEY (platform_catalog_key, platform_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_indication_source FOREIGN KEY (collection_source_catalog_key, collection_source_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_indication_metrics CHECK (
        (flight_duration_min IS NULL OR (flight_duration_min::text NOT IN ('NaN','Infinity','-Infinity') AND flight_duration_min >= 0))
        AND (lidar_point_rate IS NULL OR (lidar_point_rate::text NOT IN ('NaN','Infinity','-Infinity') AND lidar_point_rate >= 0))
        AND (payload_lb IS NULL OR (payload_lb::text NOT IN ('NaN','Infinity','-Infinity') AND payload_lb >= 0))
        AND (mission_speed_mph IS NULL OR (mission_speed_mph::text NOT IN ('NaN','Infinity','-Infinity') AND mission_speed_mph >= 0))
        AND (wind_knots IS NULL OR (wind_knots::text NOT IN ('NaN','Infinity','-Infinity') AND wind_knots >= 0))
        AND (surface_variation_mm IS NULL OR (surface_variation_mm::text NOT IN ('NaN','Infinity','-Infinity') AND surface_variation_mm >= 0))
        AND (depression_depth_cm IS NULL OR (depression_depth_cm::text NOT IN ('NaN','Infinity','-Infinity') AND depression_depth_cm >= 0))
    )
);

CREATE TABLE IF NOT EXISTS app.phase_reconnaissance (
    phase_id uuid PRIMARY KEY,
    stage_code text NOT NULL DEFAULT 'reconnaissance' CHECK (stage_code = 'reconnaissance'),
    magnetic_reading_nt numeric(14,3),
    gpr_depth_cm numeric(10,3),
    rtk_accuracy_cm numeric(10,3),
    localization_accuracy_cm numeric(10,3),
    probability_catalog_key text NOT NULL DEFAULT 'riskLevels' CHECK (probability_catalog_key = 'riskLevels'),
    probability_code text,
    priority_catalog_key text NOT NULL DEFAULT 'riskLevels' CHECK (priority_catalog_key = 'riskLevels'),
    priority_code text,
    georeferenced_point_reference text NOT NULL DEFAULT '',
    risk_map_reference text NOT NULL DEFAULT '',
    ai_classification_reference text NOT NULL DEFAULT '',
    fusion_completed boolean NOT NULL DEFAULT false,
    CONSTRAINT fk_recon_phase FOREIGN KEY (phase_id, stage_code)
        REFERENCES app.incident_phases(id, stage_code) ON DELETE CASCADE,
    CONSTRAINT fk_recon_probability FOREIGN KEY (probability_catalog_key, probability_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_recon_priority FOREIGN KEY (priority_catalog_key, priority_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_recon_metrics CHECK (
        (magnetic_reading_nt IS NULL OR magnetic_reading_nt::text NOT IN ('NaN','Infinity','-Infinity'))
        AND (gpr_depth_cm IS NULL OR (gpr_depth_cm::text NOT IN ('NaN','Infinity','-Infinity') AND gpr_depth_cm >= 0))
        AND (rtk_accuracy_cm IS NULL OR (rtk_accuracy_cm::text NOT IN ('NaN','Infinity','-Infinity') AND rtk_accuracy_cm >= 0))
        AND (localization_accuracy_cm IS NULL OR (localization_accuracy_cm::text NOT IN ('NaN','Infinity','-Infinity') AND localization_accuracy_cm >= 0))
    )
);

CREATE TABLE IF NOT EXISTS app.phase_surveillance (
    phase_id uuid PRIMARY KEY,
    stage_code text NOT NULL DEFAULT 'surveillance' CHECK (stage_code = 'surveillance'),
    observation_started_at timestamptz,
    observation_started_at_original text,
    observation_ended_at timestamptz,
    observation_ended_at_original text,
    deployment_catalog_key text NOT NULL DEFAULT 'surveillanceDeployments' CHECK (deployment_catalog_key = 'surveillanceDeployments'),
    deployment_code text,
    covered_channels integer,
    duplicated_channel_configuration boolean NOT NULL DEFAULT false,
    active_device_count integer,
    human_activity_catalog_key text NOT NULL DEFAULT 'humanActivities' CHECK (human_activity_catalog_key = 'humanActivities'),
    human_activity_code text,
    environment_decision_catalog_key text NOT NULL DEFAULT 'environmentDecisions' CHECK (environment_decision_catalog_key = 'environmentDecisions'),
    environment_decision_code text,
    CONSTRAINT fk_surveillance_phase FOREIGN KEY (phase_id, stage_code)
        REFERENCES app.incident_phases(id, stage_code) ON DELETE CASCADE,
    CONSTRAINT fk_surveillance_deployment FOREIGN KEY (deployment_catalog_key, deployment_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_surveillance_activity FOREIGN KEY (human_activity_catalog_key, human_activity_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_surveillance_decision FOREIGN KEY (environment_decision_catalog_key, environment_decision_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_surveillance_period CHECK (
        observation_started_at IS NULL OR observation_ended_at IS NULL OR observation_ended_at >= observation_started_at
    ),
    CONSTRAINT ck_surveillance_counts CHECK (
        (covered_channels IS NULL OR covered_channels >= 0)
        AND (active_device_count IS NULL OR active_device_count >= 0)
    )
);

CREATE TABLE IF NOT EXISTS app.phase_mitigation (
    phase_id uuid PRIMARY KEY,
    stage_code text NOT NULL DEFAULT 'mitigation' CHECK (stage_code = 'mitigation'),
    coordinate_received boolean NOT NULL DEFAULT false,
    platform_catalog_key text NOT NULL DEFAULT 'platforms' CHECK (platform_catalog_key = 'platforms'),
    platform_code text,
    protection_level_catalog_key text NOT NULL DEFAULT 'protectionLevels' CHECK (protection_level_catalog_key = 'protectionLevels'),
    protection_level_code text,
    personnel_protection_confirmed boolean NOT NULL DEFAULT false,
    equipment_protection_confirmed boolean NOT NULL DEFAULT false,
    detection_assets integer,
    interrogation_assets integer,
    gpr_coverage_overlap boolean NOT NULL DEFAULT false,
    safety_margin_m numeric(12,3),
    remote_interrogation_completed boolean NOT NULL DEFAULT false,
    artifact_type text NOT NULL DEFAULT '',
    orientation text NOT NULL DEFAULT '',
    activation_mechanism text NOT NULL DEFAULT '',
    eod_handoff_reference text NOT NULL DEFAULT '',
    neutralization_result_catalog_key text NOT NULL DEFAULT 'neutralizationResults' CHECK (neutralization_result_catalog_key = 'neutralizationResults'),
    neutralization_result_code text,
    route_result_catalog_key text NOT NULL DEFAULT 'routeResults' CHECK (route_result_catalog_key = 'routeResults'),
    route_result_code text,
    techint_composition text NOT NULL DEFAULT '',
    techint_manufacture text NOT NULL DEFAULT '',
    techint_signature text NOT NULL DEFAULT '',
    catalog_feedback_reference text NOT NULL DEFAULT '',
    CONSTRAINT fk_mitigation_phase FOREIGN KEY (phase_id, stage_code)
        REFERENCES app.incident_phases(id, stage_code) ON DELETE CASCADE,
    CONSTRAINT fk_mitigation_platform FOREIGN KEY (platform_catalog_key, platform_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_mitigation_protection FOREIGN KEY (protection_level_catalog_key, protection_level_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_mitigation_neutralization FOREIGN KEY (neutralization_result_catalog_key, neutralization_result_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_mitigation_route FOREIGN KEY (route_result_catalog_key, route_result_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_mitigation_counts CHECK (
        (detection_assets IS NULL OR detection_assets >= 0)
        AND (interrogation_assets IS NULL OR interrogation_assets >= 0)
        AND (safety_margin_m IS NULL OR (safety_margin_m::text NOT IN ('NaN','Infinity','-Infinity') AND safety_margin_m >= 0))
    )
);

CREATE TABLE IF NOT EXISTS app.phase_indication_signatures (
    phase_id uuid NOT NULL REFERENCES app.phase_indications(phase_id) ON DELETE CASCADE,
    signature_catalog_key text NOT NULL DEFAULT 'indicationSignatures' CHECK (signature_catalog_key = 'indicationSignatures'),
    signature_code text NOT NULL,
    PRIMARY KEY (phase_id, signature_code),
    CONSTRAINT fk_indication_signature FOREIGN KEY (signature_catalog_key, signature_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT
);
CREATE INDEX IF NOT EXISTS ix_indication_signatures_code ON app.phase_indication_signatures(signature_code, phase_id);

CREATE TABLE IF NOT EXISTS app.phase_radio_technologies (
    phase_id uuid NOT NULL REFERENCES app.phase_surveillance(phase_id) ON DELETE CASCADE,
    technology_catalog_key text NOT NULL DEFAULT 'radioTechnologies' CHECK (technology_catalog_key = 'radioTechnologies'),
    technology_code text NOT NULL,
    PRIMARY KEY (phase_id, technology_code),
    CONSTRAINT fk_radio_technology FOREIGN KEY (technology_catalog_key, technology_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT
);
CREATE INDEX IF NOT EXISTS ix_radio_technologies_code ON app.phase_radio_technologies(technology_code, phase_id);

CREATE TABLE IF NOT EXISTS app.phase_surveillance_methods (
    phase_id uuid NOT NULL REFERENCES app.phase_surveillance(phase_id) ON DELETE CASCADE,
    method_catalog_key text NOT NULL DEFAULT 'surveillanceMethods' CHECK (method_catalog_key = 'surveillanceMethods'),
    method_code text NOT NULL,
    PRIMARY KEY (phase_id, method_code),
    CONSTRAINT fk_surveillance_method FOREIGN KEY (method_catalog_key, method_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT
);
CREATE INDEX IF NOT EXISTS ix_surveillance_methods_code ON app.phase_surveillance_methods(method_code, phase_id);

-- =====================================================================
-- 4. Evidence, validations, and audit
-- =====================================================================
CREATE TABLE IF NOT EXISTS app.phase_evidence (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    phase_id uuid NOT NULL REFERENCES app.incident_phases(id) ON DELETE CASCADE,
    client_id text NOT NULL,
    sensor_catalog_key text NOT NULL DEFAULT 'sensors' CHECK (sensor_catalog_key = 'sensors'),
    sensor_code text NOT NULL,
    reference text NOT NULL DEFAULT '',
    summary text NOT NULL DEFAULT '',
    recorded_at timestamptz,
    recorded_at_original text,
    created_at timestamptz NOT NULL DEFAULT now(),
    created_by_user_id uuid REFERENCES public."AspNetUsers"("Id") ON DELETE RESTRICT,
    CONSTRAINT uq_phase_evidence_client UNIQUE (phase_id, client_id),
    CONSTRAINT fk_evidence_sensor FOREIGN KEY (sensor_catalog_key, sensor_code)
        REFERENCES app.catalog_options(catalog_key, code) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_evidence_client_id CHECK (client_id = btrim(client_id) AND client_id <> '')
);
CREATE INDEX IF NOT EXISTS ix_phase_evidence_phase_created ON app.phase_evidence(phase_id, created_at, id);
CREATE INDEX IF NOT EXISTS ix_phase_evidence_sensor ON app.phase_evidence(sensor_code, phase_id);

CREATE TABLE IF NOT EXISTS app.phase_validations (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    phase_id uuid NOT NULL UNIQUE REFERENCES app.incident_phases(id) ON DELETE RESTRICT,
    validated_at timestamptz NOT NULL DEFAULT now(),
    validated_by_user_id uuid REFERENCES public."AspNetUsers"("Id") ON DELETE RESTRICT,
    legacy_validator_name varchar(200),
    validated_revision integer NOT NULL CHECK (validated_revision >= 0),
    rules_version varchar(64) NOT NULL,
    snapshot jsonb NOT NULL,
    origin varchar(20) NOT NULL DEFAULT 'authenticated' CHECK (origin IN ('authenticated', 'legacy')),
    CONSTRAINT ck_validation_actor CHECK (
        (origin = 'authenticated' AND validated_by_user_id IS NOT NULL AND legacy_validator_name IS NULL)
        OR (origin = 'legacy' AND validated_by_user_id IS NULL AND legacy_validator_name IS NOT NULL)
    ),
    CONSTRAINT ck_validation_snapshot CHECK (jsonb_typeof(snapshot) = 'object'),
    CONSTRAINT ck_validation_rules_version CHECK (rules_version = btrim(rules_version) AND rules_version <> '')
);
CREATE INDEX IF NOT EXISTS ix_phase_validations_actor_time
    ON app.phase_validations(validated_by_user_id, validated_at DESC, id);

CREATE TABLE IF NOT EXISTS app.incident_events (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    incident_id uuid NOT NULL REFERENCES app.incidents(id) ON DELETE RESTRICT,
    client_id text,
    occurred_at timestamptz NOT NULL DEFAULT now(),
    actor_user_id uuid REFERENCES public."AspNetUsers"("Id") ON DELETE RESTRICT,
    legacy_actor_name varchar(200),
    event_text text NOT NULL,
    incident_revision integer NOT NULL CHECK (incident_revision >= 0),
    origin varchar(20) NOT NULL DEFAULT 'authenticated' CHECK (origin IN ('authenticated', 'legacy', 'system')),
    metadata jsonb NOT NULL DEFAULT '{}'::jsonb,
    CONSTRAINT uq_incident_event_client UNIQUE (incident_id, client_id),
    CONSTRAINT ck_incident_event_actor CHECK (
        (origin = 'authenticated' AND actor_user_id IS NOT NULL)
        OR origin IN ('legacy', 'system')
    ),
    CONSTRAINT ck_incident_event_text CHECK (event_text = btrim(event_text) AND event_text <> ''),
    CONSTRAINT ck_incident_event_metadata CHECK (jsonb_typeof(metadata) = 'object')
);
CREATE INDEX IF NOT EXISTS ix_incident_events_timeline
    ON app.incident_events(incident_id, occurred_at, id);

CREATE TABLE IF NOT EXISTS app.audit_events (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    occurred_at timestamptz NOT NULL DEFAULT now(),
    actor_user_id uuid REFERENCES public."AspNetUsers"("Id") ON DELETE RESTRICT,
    action varchar(100) NOT NULL,
    outcome varchar(32) NOT NULL CHECK (outcome IN ('succeeded', 'rejected', 'failed')),
    entity_type varchar(100) NOT NULL,
    entity_id text NOT NULL,
    correlation_id varchar(128),
    source_ip_hash varchar(128),
    changes jsonb NOT NULL DEFAULT '{}'::jsonb,
    security_context jsonb NOT NULL DEFAULT '{}'::jsonb,
    CONSTRAINT ck_audit_action CHECK (action = btrim(action) AND action <> ''),
    CONSTRAINT ck_audit_entity CHECK (entity_type = btrim(entity_type) AND entity_type <> '' AND entity_id <> ''),
    CONSTRAINT ck_audit_payloads CHECK (jsonb_typeof(changes) = 'object' AND jsonb_typeof(security_context) = 'object')
);
CREATE INDEX IF NOT EXISTS ix_audit_entity_time ON app.audit_events(entity_type, entity_id, occurred_at DESC, id);
CREATE INDEX IF NOT EXISTS ix_audit_actor_time ON app.audit_events(actor_user_id, occurred_at DESC, id);
CREATE INDEX IF NOT EXISTS ix_audit_correlation ON app.audit_events(correlation_id) WHERE correlation_id IS NOT NULL;

CREATE OR REPLACE FUNCTION app.audit_catalog_option_change()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
    v_actor_setting text := current_setting('app.actor_user_id', true);
    v_actor_user_id uuid;
BEGIN
    IF v_actor_setting ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
       AND EXISTS (SELECT 1 FROM public."AspNetUsers" WHERE "Id" = v_actor_setting::uuid) THEN
        v_actor_user_id := v_actor_setting::uuid;
    END IF;

    INSERT INTO app.audit_events
        (actor_user_id, action, outcome, entity_type, entity_id, changes, security_context)
    VALUES
        (v_actor_user_id,
         CASE TG_OP WHEN 'INSERT' THEN 'catalog.option.insert' ELSE 'catalog.option.update' END,
         'succeeded',
         'catalog_option',
         NEW.catalog_key || ':' || NEW.code,
         jsonb_build_object(
             'before', CASE WHEN TG_OP = 'UPDATE' THEN jsonb_build_object(
                 'label', OLD.label,
                 'sortOrder', OLD.sort_order,
                 'active', OLD.is_active,
                 'version', OLD.version,
                 'stageCodes', OLD.stage_codes,
                 'metadata', OLD.metadata) ELSE NULL END,
             'after', jsonb_build_object(
                 'label', NEW.label,
                 'sortOrder', NEW.sort_order,
                 'active', NEW.is_active,
                 'version', NEW.version,
                 'stageCodes', NEW.stage_codes,
                 'metadata', NEW.metadata)),
         jsonb_build_object('databaseRole', session_user));
    RETURN NEW;
END $$;

DROP TRIGGER IF EXISTS trg_catalog_options_audit ON app.catalog_options;
CREATE TRIGGER trg_catalog_options_audit
AFTER INSERT OR UPDATE ON app.catalog_options
FOR EACH ROW EXECUTE FUNCTION app.audit_catalog_option_change();

-- =====================================================================
-- 5. Import support
-- =====================================================================
CREATE TABLE IF NOT EXISTS app.import_batches (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    source varchar(80) NOT NULL,
    source_file_name text NOT NULL,
    source_sha256 char(64) NOT NULL,
    source_size_bytes bigint NOT NULL CHECK (source_size_bytes >= 0),
    status varchar(24) NOT NULL DEFAULT 'analyzed'
        CHECK (status IN ('analyzed', 'approved', 'running', 'completed', 'completed_with_errors', 'failed')),
    analysis jsonb NOT NULL DEFAULT '{}'::jsonb,
    owner_mapping jsonb NOT NULL DEFAULT '{}'::jsonb,
    time_zone_mapping jsonb NOT NULL DEFAULT '{}'::jsonb,
    record_count integer NOT NULL DEFAULT 0 CHECK (record_count >= 0),
    imported_count integer NOT NULL DEFAULT 0 CHECK (imported_count >= 0),
    rejected_count integer NOT NULL DEFAULT 0 CHECK (rejected_count >= 0),
    created_at timestamptz NOT NULL DEFAULT now(),
    approved_at timestamptz,
    approved_by_user_id uuid REFERENCES public."AspNetUsers"("Id") ON DELETE RESTRICT,
    completed_at timestamptz,
    CONSTRAINT uq_import_source_hash UNIQUE (source, source_sha256),
    CONSTRAINT ck_import_source CHECK (source = btrim(source) AND source <> ''),
    CONSTRAINT ck_import_hash CHECK (source_sha256 ~ '^[0-9a-f]{64}$'),
    CONSTRAINT ck_import_json CHECK (
        jsonb_typeof(analysis) = 'object'
        AND jsonb_typeof(owner_mapping) = 'object'
        AND jsonb_typeof(time_zone_mapping) = 'object'
    ),
    CONSTRAINT ck_import_approval CHECK (
        (approved_at IS NULL AND approved_by_user_id IS NULL)
        OR (approved_at IS NOT NULL AND approved_by_user_id IS NOT NULL)
    )
);

CREATE TABLE IF NOT EXISTS app.legacy_records (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    batch_id uuid NOT NULL REFERENCES app.import_batches(id) ON DELETE RESTRICT,
    source varchar(80) NOT NULL,
    source_record_id text NOT NULL,
    source_hash char(64) NOT NULL,
    original_payload_json text NOT NULL,
    parsed_payload jsonb,
    disposition varchar(24) NOT NULL DEFAULT 'pending'
        CHECK (disposition IN ('pending', 'imported', 'rejected', 'reconciliation_required')),
    error_code varchar(100),
    error_detail text,
    created_at timestamptz NOT NULL DEFAULT now(),
    processed_at timestamptz,
    CONSTRAINT uq_legacy_record_identity UNIQUE (source, source_record_id, source_hash),
    CONSTRAINT ck_legacy_record_id CHECK (source_record_id <> ''),
    CONSTRAINT ck_legacy_record_hash CHECK (source_hash ~ '^[0-9a-f]{64}$'),
    CONSTRAINT ck_legacy_payload CHECK (parsed_payload IS NULL OR jsonb_typeof(parsed_payload) IN ('object', 'array')),
    CONSTRAINT ck_legacy_error CHECK (
        (disposition <> 'rejected') OR error_code IS NOT NULL
    )
);
CREATE INDEX IF NOT EXISTS ix_legacy_records_batch_disposition
    ON app.legacy_records(batch_id, disposition, id);

-- A protected original is archived once, but the same occurrence may be
-- present in more than one approved source file. Membership therefore belongs
-- to a batch and source index rather than to legacy_records.batch_id alone.
CREATE TABLE IF NOT EXISTS app.legacy_batch_records (
    batch_id uuid NOT NULL REFERENCES app.import_batches(id) ON DELETE RESTRICT,
    source_index integer NOT NULL CHECK (source_index >= 0),
    legacy_record_id uuid NOT NULL REFERENCES app.legacy_records(id) ON DELETE RESTRICT,
    disposition varchar(24) NOT NULL DEFAULT 'pending',
    error_code varchar(100),
    error_detail text,
    linked_at timestamptz NOT NULL DEFAULT now(),
    processed_at timestamptz,
    PRIMARY KEY (batch_id, source_index),
    CONSTRAINT ck_legacy_batch_record_disposition CHECK (
        disposition IN ('pending', 'imported', 'rejected', 'reconciliation_required')
    ),
    CONSTRAINT ck_legacy_batch_record_error CHECK (
        (disposition IN ('pending','imported') AND error_code IS NULL)
        OR (disposition IN ('rejected','reconciliation_required') AND error_code IS NOT NULL)
    )
);
CREATE INDEX IF NOT EXISTS ix_legacy_batch_records_legacy_record
    ON app.legacy_batch_records(legacy_record_id, batch_id);

-- Upgrade databases produced by the previous direct-SQL contract. That
-- importer archived records sequentially, so creation order is the only
-- recoverable source-index ordering. Batches already using explicit links are
-- excluded, which keeps this backfill idempotent.
WITH ranked AS (
    SELECT
        r.batch_id,
        (row_number() OVER (PARTITION BY r.batch_id ORDER BY r.created_at, r.id) - 1)::integer AS source_index,
        r.id AS legacy_record_id,
        r.disposition,
        r.error_code,
        r.error_detail,
        r.processed_at
    FROM app.legacy_records r
    WHERE NOT EXISTS (
        SELECT 1 FROM app.legacy_batch_records existing
        WHERE existing.batch_id=r.batch_id
    )
)
INSERT INTO app.legacy_batch_records(
    batch_id, source_index, legacy_record_id, disposition, error_code, error_detail, processed_at)
SELECT
    batch_id,
    source_index,
    legacy_record_id,
    disposition,
    CASE
        WHEN disposition IN ('pending','imported') THEN NULL
        WHEN disposition='reconciliation_required' THEN
            COALESCE(NULLIF(btrim(error_code), ''), 'legacy-backfill-reconciliation-required')
        WHEN disposition='rejected' THEN
            COALESCE(NULLIF(btrim(error_code), ''), 'legacy-backfill-rejected')
    END AS error_code,
    CASE
        WHEN disposition IN ('pending','imported') THEN NULL
        ELSE error_detail
    END AS error_detail,
    processed_at
FROM ranked
ON CONFLICT (batch_id, source_index) DO NOTHING;

-- A previous importer could mark a batch complete without every declared
-- occurrence archived or while an occurrence remained pending. Reopen those
-- batches so a reviewed rerun must finish them before cutover.
WITH totals AS (
    SELECT
        b.id,
        count(br.source_index)::integer AS linked_count,
        count(*) FILTER (WHERE br.disposition='pending')::integer AS pending_count
    FROM app.import_batches b
    LEFT JOIN app.legacy_batch_records br ON br.batch_id=b.id
    LEFT JOIN app.legacy_records r ON r.id=br.legacy_record_id
    GROUP BY b.id
)
UPDATE app.import_batches b
SET status='running', completed_at=NULL
FROM totals
WHERE totals.id=b.id
  AND b.status IN ('completed','completed_with_errors')
  AND (totals.linked_count <> b.record_count OR totals.pending_count > 0);

CREATE TABLE IF NOT EXISTS app.legacy_id_mappings (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    legacy_record_id uuid NOT NULL REFERENCES app.legacy_records(id) ON DELETE RESTRICT,
    entity_type varchar(80) NOT NULL,
    source_id text NOT NULL,
    target_id uuid,
    target_public_id text,
    legacy_user_id text,
    mapping_status varchar(24) NOT NULL DEFAULT 'mapped'
        CHECK (mapping_status IN ('mapped', 'pending', 'rejected')),
    created_at timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT uq_legacy_mapping UNIQUE (legacy_record_id, entity_type, source_id),
    CONSTRAINT ck_legacy_target CHECK (
        mapping_status <> 'mapped' OR target_id IS NOT NULL OR target_public_id IS NOT NULL
    )
);
CREATE INDEX IF NOT EXISTS ix_legacy_mappings_target ON app.legacy_id_mappings(entity_type, target_id)
    WHERE target_id IS NOT NULL;

-- =====================================================================
-- 6. Workflow guards
-- =====================================================================
CREATE OR REPLACE FUNCTION app.touch_updated_at()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    NEW.updated_at := now();
    RETURN NEW;
END $$;

CREATE OR REPLACE FUNCTION app.initialize_incident_phases()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
    v_stage text;
    v_phase_id uuid;
BEGIN
    FOREACH v_stage IN ARRAY ARRAY['indications', 'reconnaissance', 'surveillance', 'mitigation'] LOOP
        INSERT INTO app.incident_phases(incident_id, stage_code)
        VALUES (NEW.id, v_stage)
        RETURNING id INTO v_phase_id;

        INSERT INTO app.phase_reviews(phase_id) VALUES (v_phase_id);
        CASE v_stage
            WHEN 'indications' THEN INSERT INTO app.phase_indications(phase_id) VALUES (v_phase_id);
            WHEN 'reconnaissance' THEN INSERT INTO app.phase_reconnaissance(phase_id) VALUES (v_phase_id);
            WHEN 'surveillance' THEN INSERT INTO app.phase_surveillance(phase_id) VALUES (v_phase_id);
            WHEN 'mitigation' THEN INSERT INTO app.phase_mitigation(phase_id) VALUES (v_phase_id);
        END CASE;
    END LOOP;
    RETURN NEW;
END $$;

DROP TRIGGER IF EXISTS trg_incident_initialize_phases ON app.incidents;
CREATE TRIGGER trg_incident_initialize_phases
AFTER INSERT ON app.incidents
FOR EACH ROW EXECUTE FUNCTION app.initialize_incident_phases();

CREATE OR REPLACE FUNCTION app.verify_incident_phase_set()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
    v_incident_id uuid;
    v_stages text[];
    v_review_count integer;
    v_detail_count integer;
BEGIN
    IF TG_TABLE_NAME = 'incidents' THEN
        v_incident_id := CASE WHEN TG_OP = 'DELETE' THEN OLD.id ELSE NEW.id END;
    ELSE
        v_incident_id := CASE WHEN TG_OP = 'DELETE' THEN OLD.incident_id ELSE NEW.incident_id END;
    END IF;
    IF NOT EXISTS (SELECT 1 FROM app.incidents WHERE id = v_incident_id) THEN
        IF TG_OP = 'DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;
    END IF;

    SELECT array_agg(stage_code ORDER BY stage_code), count(*)
      INTO v_stages, v_review_count
      FROM app.incident_phases
     WHERE incident_id = v_incident_id;

    IF v_review_count <> 4 OR v_stages <> ARRAY['indications','mitigation','reconnaissance','surveillance']::text[] THEN
        RAISE EXCEPTION 'incident % must contain exactly the four workflow stages', v_incident_id
            USING ERRCODE = '23514';
    END IF;

    SELECT count(*) INTO v_review_count
      FROM app.phase_reviews r JOIN app.incident_phases p ON p.id = r.phase_id
     WHERE p.incident_id = v_incident_id;
    SELECT
        (SELECT count(*) FROM app.phase_indications d JOIN app.incident_phases p ON p.id=d.phase_id WHERE p.incident_id=v_incident_id)
      + (SELECT count(*) FROM app.phase_reconnaissance d JOIN app.incident_phases p ON p.id=d.phase_id WHERE p.incident_id=v_incident_id)
      + (SELECT count(*) FROM app.phase_surveillance d JOIN app.incident_phases p ON p.id=d.phase_id WHERE p.incident_id=v_incident_id)
      + (SELECT count(*) FROM app.phase_mitigation d JOIN app.incident_phases p ON p.id=d.phase_id WHERE p.incident_id=v_incident_id)
      INTO v_detail_count;
    IF v_review_count <> 4 OR v_detail_count <> 4 THEN
        RAISE EXCEPTION 'incident % must contain one review and one typed detail per stage', v_incident_id
            USING ERRCODE = '23514';
    END IF;
    IF TG_OP = 'DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;
END $$;

DROP TRIGGER IF EXISTS trg_incident_complete_phases ON app.incidents;
CREATE CONSTRAINT TRIGGER trg_incident_complete_phases
AFTER INSERT OR UPDATE ON app.incidents DEFERRABLE INITIALLY DEFERRED
FOR EACH ROW EXECUTE FUNCTION app.verify_incident_phase_set();
DROP TRIGGER IF EXISTS trg_phase_complete_set ON app.incident_phases;
CREATE CONSTRAINT TRIGGER trg_phase_complete_set
AFTER INSERT OR UPDATE OR DELETE ON app.incident_phases DEFERRABLE INITIALLY DEFERRED
FOR EACH ROW EXECUTE FUNCTION app.verify_incident_phase_set();

CREATE OR REPLACE FUNCTION app.assert_phase_mutable(p_phase_id uuid)
RETURNS void LANGUAGE plpgsql AS $$
DECLARE
    v_status text;
    v_deleted_at timestamptz;
BEGIN
    SELECT i.status_code, i.deleted_at
      INTO v_status, v_deleted_at
      FROM app.incident_phases p
      JOIN app.incidents i ON i.id = p.incident_id
     WHERE p.id = p_phase_id
     FOR UPDATE OF i;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'phase % does not exist', p_phase_id USING ERRCODE = '23503';
    END IF;
    IF v_deleted_at IS NOT NULL OR v_status <> 'open' THEN
        RAISE EXCEPTION 'phase belongs to a closed, discarded, or deleted incident' USING ERRCODE = '55000';
    END IF;
    IF EXISTS (SELECT 1 FROM app.phase_validations WHERE phase_id = p_phase_id) THEN
        RAISE EXCEPTION 'validated phase is immutable' USING ERRCODE = '55000';
    END IF;
END $$;

CREATE OR REPLACE FUNCTION app.guard_phase_row_mutation()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    PERFORM app.assert_phase_mutable(CASE WHEN TG_OP = 'DELETE' THEN OLD.id ELSE NEW.id END);
    RETURN CASE WHEN TG_OP = 'DELETE' THEN OLD ELSE NEW END;
END $$;

CREATE OR REPLACE FUNCTION app.guard_phase_child_mutation()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    IF TG_OP = 'UPDATE' AND NEW.phase_id IS DISTINCT FROM OLD.phase_id THEN
        -- Reparenting must not be used to remove a row from a validated phase.
        PERFORM app.assert_phase_mutable(OLD.phase_id);
        PERFORM app.assert_phase_mutable(NEW.phase_id);
    ELSE
        PERFORM app.assert_phase_mutable(CASE WHEN TG_OP = 'DELETE' THEN OLD.phase_id ELSE NEW.phase_id END);
    END IF;
    RETURN CASE WHEN TG_OP = 'DELETE' THEN OLD ELSE NEW END;
END $$;

DROP TRIGGER IF EXISTS trg_guard_incident_phase ON app.incident_phases;
CREATE TRIGGER trg_guard_incident_phase BEFORE UPDATE OR DELETE ON app.incident_phases
FOR EACH ROW EXECUTE FUNCTION app.guard_phase_row_mutation();

DO $guards$
DECLARE v_table text;
BEGIN
    FOREACH v_table IN ARRAY ARRAY[
        'phase_reviews', 'phase_indications', 'phase_reconnaissance', 'phase_surveillance',
        'phase_mitigation', 'phase_indication_signatures', 'phase_radio_technologies',
        'phase_surveillance_methods', 'phase_evidence'
    ] LOOP
        EXECUTE format('DROP TRIGGER IF EXISTS trg_guard_mutation ON app.%I', v_table);
        EXECUTE format(
            'CREATE TRIGGER trg_guard_mutation BEFORE INSERT OR UPDATE OR DELETE ON app.%I '
            'FOR EACH ROW EXECUTE FUNCTION app.guard_phase_child_mutation()', v_table
        );
    END LOOP;
END $guards$;

CREATE OR REPLACE FUNCTION app.guard_incident_mutation()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_has_validation boolean;
BEGIN
    IF TG_OP = 'DELETE' THEN
        RAISE EXCEPTION 'physical deletion of incidents is forbidden; use soft deletion' USING ERRCODE = '55000';
    END IF;
    IF OLD.deleted_at IS NOT NULL THEN
        RAISE EXCEPTION 'deleted incident is immutable' USING ERRCODE = '55000';
    END IF;
    IF NEW.revision < OLD.revision OR NEW.revision > OLD.revision + 1 THEN
        RAISE EXCEPTION 'incident revision must advance by at most one' USING ERRCODE = '40001';
    END IF;
    SELECT EXISTS (
        SELECT 1 FROM app.phase_validations v
        JOIN app.incident_phases p ON p.id = v.phase_id
        WHERE p.incident_id = OLD.id
    ) INTO v_has_validation;
    IF v_has_validation AND (
        NEW.owner_user_id IS DISTINCT FROM OLD.owner_user_id
        OR NEW.public_id IS DISTINCT FROM OLD.public_id
        OR NEW.title IS DISTINCT FROM OLD.title
        OR NEW.content IS DISTINCT FROM OLD.content
        OR NEW.area_of_interest IS DISTINCT FROM OLD.area_of_interest
        OR NEW.latitude IS DISTINCT FROM OLD.latitude
        OR NEW.longitude IS DISTINCT FROM OLD.longitude
    ) THEN
        RAISE EXCEPTION 'incident base data is immutable after first phase validation' USING ERRCODE = '55000';
    END IF;
    IF OLD.status_code <> 'open' AND NEW.status_code IS DISTINCT FROM OLD.status_code THEN
        RAISE EXCEPTION 'closed or discarded incident cannot be reopened' USING ERRCODE = '55000';
    END IF;
    IF NEW.status_code IS DISTINCT FROM OLD.status_code THEN
        IF NEW.status_code = 'closed' AND NOT EXISTS (
            SELECT 1 FROM app.phase_validations v
            JOIN app.incident_phases p ON p.id=v.phase_id
            WHERE p.incident_id=OLD.id AND p.stage_code='mitigation'
        ) THEN
            RAISE EXCEPTION 'incident can close only after mitigation validation' USING ERRCODE = '55000';
        ELSIF NEW.status_code = 'discarded' AND NOT EXISTS (
            SELECT 1 FROM app.phase_validations v
            JOIN app.incident_phases p ON p.id=v.phase_id
            JOIN app.phase_reviews r ON r.phase_id=p.id
            WHERE p.incident_id=OLD.id AND p.stage_code='reconnaissance' AND r.finding_code='false-positive'
        ) THEN
            RAISE EXCEPTION 'incident can be discarded only by a validated false positive' USING ERRCODE = '55000';
        ELSIF NEW.status_code NOT IN ('open','closed','discarded') THEN
            RAISE EXCEPTION 'invalid workflow status transition' USING ERRCODE = '55000';
        END IF;
    END IF;
    RETURN NEW;
END $$;

DROP TRIGGER IF EXISTS trg_guard_incident_mutation ON app.incidents;
CREATE TRIGGER trg_guard_incident_mutation BEFORE UPDATE OR DELETE ON app.incidents
FOR EACH ROW EXECUTE FUNCTION app.guard_incident_mutation();
DROP TRIGGER IF EXISTS trg_touch_incident ON app.incidents;
CREATE TRIGGER trg_touch_incident BEFORE UPDATE ON app.incidents
FOR EACH ROW EXECUTE FUNCTION app.touch_updated_at();
DROP TRIGGER IF EXISTS trg_touch_phase ON app.incident_phases;
CREATE TRIGGER trg_touch_phase BEFORE UPDATE ON app.incident_phases
FOR EACH ROW EXECUTE FUNCTION app.touch_updated_at();

CREATE OR REPLACE FUNCTION app.guard_phase_validation_insert()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
    v_incident_id uuid;
    v_stage text;
    v_status text;
    v_prior_required integer;
    v_prior_validated integer;
BEGIN
    IF NEW.origin = 'legacy' AND NOT pg_has_role(current_user, 'gds_db_deployer', 'member') THEN
        RAISE EXCEPTION 'legacy validations require the database deployment role' USING ERRCODE = '42501';
    END IF;
    SELECT p.incident_id, p.stage_code, i.status_code
      INTO v_incident_id, v_stage, v_status
      FROM app.incident_phases p
      JOIN app.incidents i ON i.id = p.incident_id
     WHERE p.id = NEW.phase_id
     FOR UPDATE OF i;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'phase does not exist' USING ERRCODE = '23503';
    END IF;
    IF v_status <> 'open' THEN
        RAISE EXCEPTION 'incident is not open' USING ERRCODE = '55000';
    END IF;
    v_prior_required := CASE v_stage
        WHEN 'indications' THEN 0 WHEN 'reconnaissance' THEN 1
        WHEN 'surveillance' THEN 2 WHEN 'mitigation' THEN 3 ELSE 99 END;
    SELECT count(*) INTO v_prior_validated
      FROM app.phase_validations v
      JOIN app.incident_phases p ON p.id = v.phase_id
     WHERE p.incident_id = v_incident_id
       AND CASE p.stage_code WHEN 'indications' THEN 1 WHEN 'reconnaissance' THEN 2
                            WHEN 'surveillance' THEN 3 WHEN 'mitigation' THEN 4 END <= v_prior_required;
    IF v_prior_validated <> v_prior_required THEN
        RAISE EXCEPTION 'previous workflow phases must be validated first' USING ERRCODE = '55000';
    END IF;
    RETURN NEW;
END $$;

CREATE OR REPLACE FUNCTION app.apply_validation_transition()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_incident_id uuid; v_stage text; v_finding text;
BEGIN
    SELECT p.incident_id, p.stage_code, r.finding_code
      INTO v_incident_id, v_stage, v_finding
      FROM app.incident_phases p JOIN app.phase_reviews r ON r.phase_id=p.id
     WHERE p.id=NEW.phase_id;
    IF v_stage = 'reconnaissance' AND v_finding = 'false-positive' THEN
        UPDATE app.incidents SET status_code='discarded' WHERE id=v_incident_id;
    ELSIF v_stage = 'mitigation' THEN
        UPDATE app.incidents SET status_code='closed' WHERE id=v_incident_id;
    END IF;
    RETURN NEW;
END $$;

DROP TRIGGER IF EXISTS trg_validation_guard ON app.phase_validations;
CREATE TRIGGER trg_validation_guard BEFORE INSERT ON app.phase_validations
FOR EACH ROW EXECUTE FUNCTION app.guard_phase_validation_insert();
DROP TRIGGER IF EXISTS trg_validation_transition ON app.phase_validations;
CREATE TRIGGER trg_validation_transition AFTER INSERT ON app.phase_validations
FOR EACH ROW EXECUTE FUNCTION app.apply_validation_transition();

CREATE OR REPLACE FUNCTION app.reject_immutable_change()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    RAISE EXCEPTION '% rows are append-only', TG_TABLE_NAME USING ERRCODE = '55000';
END $$;

DO $immutable$
DECLARE v_table text;
BEGIN
    FOREACH v_table IN ARRAY ARRAY['phase_validations', 'incident_events', 'audit_events'] LOOP
        EXECUTE format('DROP TRIGGER IF EXISTS trg_append_only ON app.%I', v_table);
        EXECUTE format(
            'CREATE TRIGGER trg_append_only BEFORE UPDATE OR DELETE ON app.%I '
            'FOR EACH ROW EXECUTE FUNCTION app.reject_immutable_change()', v_table
        );
    END LOOP;
END $immutable$;

