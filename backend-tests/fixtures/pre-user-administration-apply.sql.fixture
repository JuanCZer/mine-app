-- =====================================================================
-- 8. Database roles and grants
-- =====================================================================
-- Database roles are group roles without LOGIN. Operations may grant them to
-- environment-specific login roles; this file creates no user or credential.
DO $roles$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'gds_db_deployer') THEN
        CREATE ROLE gds_db_deployer NOLOGIN NOINHERIT;
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'gds_app_runtime') THEN
        CREATE ROLE gds_app_runtime NOLOGIN NOINHERIT;
    END IF;
END $roles$;

-- Identity reads plus password/lockout/stamp updates are needed at runtime.
-- Account/role provisioning runs under the separate administrative role.
GRANT USAGE ON SCHEMA public TO gds_app_runtime;
GRANT SELECT ON public."AspNetUsers", public."AspNetRoles", public."AspNetUserRoles",
    public."AspNetUserClaims", public."AspNetRoleClaims", public."AspNetUserLogins",
    public."AspNetUserTokens" TO gds_app_runtime;
-- Revoke the older table-wide grant on every apply, including upgrades.
REVOKE UPDATE ON public."AspNetUsers" FROM gds_app_runtime;
GRANT UPDATE ("PasswordHash", "SecurityStamp", "ConcurrencyStamp",
    "AccessFailedCount", "LockoutEnd", "UpdatedAt") ON public."AspNetUsers" TO gds_app_runtime;
GRANT USAGE ON SCHEMA app TO gds_app_runtime;
GRANT SELECT ON
    app.catalog_options,
    app.cat_mexico_states, app.cat_soils, app.cat_seasons, app.cat_risk_levels,
    app.cat_sensors, app.cat_platforms, app.cat_indication_sources,
    app.cat_indication_signatures, app.cat_radio_technologies,
    app.cat_surveillance_methods, app.cat_surveillance_deployments,
    app.cat_human_activities, app.cat_environment_decisions,
    app.cat_protection_levels, app.cat_neutralization_results,
    app.cat_route_results, app.cat_findings, app.cat_environment_reviews,
    app.cat_workflow_statuses, app.workflow_stages
TO gds_app_runtime;
GRANT SELECT, INSERT, UPDATE ON
    app.incidents, app.incident_phases, app.phase_reviews,
    app.phase_indications, app.phase_reconnaissance, app.phase_surveillance, app.phase_mitigation
TO gds_app_runtime;
GRANT SELECT, INSERT, UPDATE, DELETE ON
    app.phase_indication_signatures, app.phase_radio_technologies,
    app.phase_surveillance_methods, app.phase_evidence
TO gds_app_runtime;
GRANT SELECT, INSERT ON app.phase_validations, app.incident_events TO gds_app_runtime;
GRANT INSERT ON app.audit_events TO gds_app_runtime;

-- DDL/import privileges are assigned operationally to a deployment
-- login. This role has no LOGIN and contains no credential.
GRANT USAGE, CREATE ON SCHEMA app TO gds_db_deployer;
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA app TO gds_db_deployer;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA app TO gds_db_deployer;

-- Identity provisioning is an explicit local administrative command using
-- UserManager/RoleManager. Runtime cannot insert accounts or assign roles.
GRANT USAGE ON SCHEMA public TO gds_db_deployer;
GRANT SELECT, INSERT, UPDATE, DELETE ON public."AspNetUsers", public."AspNetRoles",
    public."AspNetUserRoles", public."AspNetUserClaims", public."AspNetRoleClaims",
    public."AspNetUserLogins", public."AspNetUserTokens" TO gds_db_deployer;
GRANT USAGE, SELECT ON SEQUENCE public."AspNetUserClaims_Id_seq", public."AspNetRoleClaims_Id_seq" TO gds_db_deployer;
-- Minimum application roles are created by the administrative command. No
-- default account, password, or role assignment is seeded by this SQL.

-- =====================================================================
-- 9. Schema integrity checks
-- The following result sets must be empty.
-- =====================================================================

DO $check$
DECLARE
    v_missing text[];
    v_missing_constraints text[];
    v_stage_count integer;
BEGIN
    SELECT array_agg(expected.name ORDER BY expected.name)
      INTO v_missing
      FROM (VALUES
          ('incidents'), ('incident_phases'), ('phase_reviews'), ('phase_indications'),
          ('phase_reconnaissance'), ('phase_surveillance'), ('phase_mitigation'),
          ('phase_indication_signatures'), ('phase_radio_technologies'),
          ('phase_surveillance_methods'), ('phase_evidence'), ('phase_validations'),
          ('incident_events'), ('audit_events'), ('import_batches'), ('legacy_records'),
          ('legacy_batch_records'), ('legacy_id_mappings'), ('catalog_options')
      ) AS expected(name)
     WHERE to_regclass('app.' || expected.name) IS NULL;
    IF v_missing IS NOT NULL THEN
        RAISE EXCEPTION 'missing application tables: %', v_missing;
    END IF;

    IF to_regclass('public."AspNetUsers"') IS NULL OR to_regclass('public."AspNetRoles"') IS NULL THEN
        RAISE EXCEPTION 'ASP.NET Core Identity base tables are missing';
    END IF;

    SELECT array_agg(expected.name ORDER BY expected.name)
      INTO v_missing_constraints
      FROM (VALUES
          ('fk_incident_status'), ('ck_incident_coordinates'), ('uq_incident_phase'),
          ('fk_phase_stage'), ('fk_phase_soil'), ('fk_phase_season'),
          ('fk_indication_phase'), ('fk_recon_phase'), ('fk_surveillance_phase'),
          ('fk_mitigation_phase'), ('uq_phase_evidence_client'),
          ('ck_validation_actor'), ('ck_validation_snapshot'),
          ('uq_import_source_hash'), ('uq_legacy_record_identity'),
          ('legacy_batch_records_pkey'), ('legacy_batch_records_batch_id_fkey'),
          ('legacy_batch_records_legacy_record_id_fkey'),
          ('ck_legacy_batch_record_disposition'), ('ck_legacy_batch_record_error')
      ) AS expected(name)
     WHERE NOT EXISTS (
         SELECT 1 FROM pg_constraint
         WHERE connamespace = 'app'::regnamespace AND conname = expected.name
     );
    IF v_missing_constraints IS NOT NULL THEN
        RAISE EXCEPTION 'existing schema is incompatible; missing constraints: %', v_missing_constraints;
    END IF;

    SELECT count(*) INTO v_stage_count
      FROM app.catalog_options
     WHERE catalog_key='workflowStages'
       AND code IN ('indications','reconnaissance','surveillance','mitigation');
    IF v_stage_count <> 4 THEN
        RAISE EXCEPTION 'workflowStages must contain all four canonical stages';
    END IF;

    IF NOT EXISTS (
        SELECT 1 FROM pg_trigger
        WHERE tgrelid='app.phase_validations'::regclass AND tgname='trg_append_only' AND NOT tgisinternal
    ) THEN
        RAISE EXCEPTION 'append-only validation guard is missing';
    END IF;
    IF NOT EXISTS (
        SELECT 1 FROM pg_trigger
        WHERE tgrelid='app.incidents'::regclass AND tgname='trg_incident_initialize_phases' AND NOT tgisinternal
    ) THEN
        RAISE EXCEPTION 'incident phase initialization trigger is missing';
    END IF;
    IF NOT EXISTS (
        SELECT 1 FROM pg_trigger
        WHERE tgrelid='app.phase_validations'::regclass AND tgname='trg_validation_guard' AND NOT tgisinternal
    ) THEN
        RAISE EXCEPTION 'validation ordering and actor guard is missing';
    END IF;
    IF NOT EXISTS (
        SELECT 1 FROM pg_trigger
        WHERE tgrelid='app.catalog_options'::regclass AND tgname='trg_catalog_options_audit' AND NOT tgisinternal
    ) THEN
        RAISE EXCEPTION 'catalog audit trigger is missing';
    END IF;
END $check$;

-- These result sets must all be empty.
SELECT i.public_id, count(p.id) AS phase_count
FROM app.incidents i LEFT JOIN app.incident_phases p ON p.incident_id=i.id
GROUP BY i.id, i.public_id HAVING count(p.id) <> 4;

SELECT i.public_id, p.stage_code, count(*) AS duplicate_count
FROM app.incidents i JOIN app.incident_phases p ON p.incident_id=i.id
GROUP BY i.public_id, p.stage_code HAVING count(*) <> 1;

SELECT p.id, p.stage_code
FROM app.incident_phases p
LEFT JOIN app.phase_reviews r ON r.phase_id=p.id
WHERE r.phase_id IS NULL;

SELECT p.id, p.stage_code
FROM app.incident_phases p
WHERE (p.stage_code='indications' AND NOT EXISTS (SELECT 1 FROM app.phase_indications d WHERE d.phase_id=p.id))
   OR (p.stage_code='reconnaissance' AND NOT EXISTS (SELECT 1 FROM app.phase_reconnaissance d WHERE d.phase_id=p.id))
   OR (p.stage_code='surveillance' AND NOT EXISTS (SELECT 1 FROM app.phase_surveillance d WHERE d.phase_id=p.id))
   OR (p.stage_code='mitigation' AND NOT EXISTS (SELECT 1 FROM app.phase_mitigation d WHERE d.phase_id=p.id));

SELECT v.id, p.stage_code, i.status_code
FROM app.phase_validations v
JOIN app.incident_phases p ON p.id=v.phase_id
JOIN app.incidents i ON i.id=p.incident_id
WHERE (p.stage_code='mitigation' AND i.status_code <> 'closed')
   OR (p.stage_code='reconnaissance'
       AND (SELECT finding_code FROM app.phase_reviews WHERE phase_id=p.id)='false-positive'
       AND i.status_code <> 'discarded');

-- =====================================================================
-- 10. Import reconciliation report
-- Re-run this complete idempotent file after a legacy import. The first
-- result set reports batch totals; every subsequent result set must be
-- empty before cutover.
-- =====================================================================

-- One row per batch; pending/rejected values must be resolved before cutover.
SELECT
    b.id,
    b.source,
    b.source_file_name,
    b.status,
    b.record_count AS declared_records,
    count(br.source_index) AS linked_records,
    count(*) FILTER (WHERE br.disposition='imported') AS imported_records,
    count(*) FILTER (WHERE br.disposition='pending') AS pending_records,
    count(*) FILTER (WHERE br.disposition='rejected') AS rejected_records,
    count(*) FILTER (WHERE br.disposition='reconciliation_required') AS reconciliation_required
FROM app.import_batches b
LEFT JOIN app.legacy_batch_records br ON br.batch_id=b.id
LEFT JOIN app.legacy_records r ON r.id=br.legacy_record_id
GROUP BY b.id, b.source, b.source_file_name, b.status, b.record_count
ORDER BY b.created_at, b.id;

-- Must be empty before cutover: an imported original without an ID mapping.
SELECT r.id, r.source, r.source_record_id
FROM app.legacy_records r
LEFT JOIN app.legacy_id_mappings m
  ON m.legacy_record_id=r.id
 AND m.entity_type='incident'
 AND m.mapping_status='mapped'
 AND (m.target_id IS NOT NULL OR m.target_public_id IS NOT NULL)
WHERE r.disposition='imported' AND m.id IS NULL;

-- Must be empty: mapping points at no incident.
SELECT m.id, m.source_id, m.target_id, m.target_public_id
FROM app.legacy_id_mappings m
LEFT JOIN app.incidents i_by_id ON i_by_id.id=m.target_id
LEFT JOIN app.incidents i_by_public ON i_by_public.public_id=m.target_public_id
WHERE m.entity_type='incident'
  AND m.mapping_status='mapped'
  AND (
      (m.target_id IS NULL AND m.target_public_id IS NULL)
      OR (m.target_id IS NOT NULL AND i_by_id.id IS NULL)
      OR (m.target_public_id IS NOT NULL AND i_by_public.id IS NULL)
      OR (
          m.target_id IS NOT NULL
          AND m.target_public_id IS NOT NULL
          AND i_by_id.id IS DISTINCT FROM i_by_public.id
      )
  );

-- Must be empty: incident mappings still awaiting resolution or rejected.
SELECT m.id, m.legacy_record_id, m.source_id, m.mapping_status
FROM app.legacy_id_mappings m
WHERE m.entity_type='incident' AND m.mapping_status IN ('pending','rejected')
ORDER BY m.created_at, m.id;

-- Explicitly list batch-specific ambiguous times, duplicate occurrences and
-- unknown catalog values retained for review.
SELECT br.batch_id, br.source_index, r.id, r.source, r.source_record_id,
       br.error_code, br.error_detail
FROM app.legacy_batch_records br
JOIN app.legacy_records r ON r.id=br.legacy_record_id
WHERE br.disposition IN ('pending','rejected','reconciliation_required')
ORDER BY r.source, r.source_record_id, br.batch_id, br.source_index;

COMMIT;
