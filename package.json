{
  "name": "mine-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:env": "node scripts/generate-public-env.mjs",
    "prestart": "npm run generate:env",
    "start": "ng serve",
    "backend": "node scripts/run-backend.mjs",
    "db:apply": "node scripts/apply-database.mjs",
    "legacy": "node scripts/import-legacy.mjs",
    "prebuild": "npm run generate:env",
    "build": "ng build",
    "build:clean": "node scripts/build-angular-clean.mjs",
    "prewatch": "npm run generate:env",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:env",
    "test": "ng test",
    "test:env": "node --test scripts/tests/environment.test.mjs",
    "test:postgres:objective4": "python3 backend-tests/objective4_postgres_runner.py",
    "test:postgres:user-administration": "python3 backend-tests/user_administration_postgres_runner.py"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "mapbox-gl": "^3.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "jsdom": "^28.0.0",
    "less": "^4.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
