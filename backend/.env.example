# Conexión runtime de privilegios mínimos usada por la API.
ConnectionStrings__Postgres=

# Conexión aislada del LOGIN miembro de gds_identity_admin. No usa fallback.
ConnectionStrings__IdentityAdmin=

# Claves HMAC versionadas. PostgreSQL decide cuál key_id está active.
IdentitySecurity__RateLimitHmacKeys__0__KeyId=rate-limit-v1
IdentitySecurity__RateLimitHmacKeys__0__SecretBase64=

# Conexión de despliegue para aplicar backend/Database/apply.sql con psql.
POSTGRES_DEPLOY_URL=
